# Turtlemint Automation Environment Variables
# Copy this file to .env and update values as needed

# Base URL for the application (dev/stage/prod)
BASE_URL=https://www.turtlemintinsurance.com/
APP_BASE_URL=https://app.turtlemintinsurance.com/

# Comma-separated pincodes for Advisor testing
PINCODES=400001,110001,560001

# CI/CD flags
CI=false

# Browser settings
HEADLESS=true
SLOW_MO=0

# Timeouts (milliseconds)
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# Test configuration
RETRIES=0
WORKERS=4

# Reporting
HTML_REPORT=true
ALLURE_REPORT=true
JSON_REPORT=true